DATABASE_URL=postgres://promises:promises@localhost:5432/promises
REDIS_URL=redis://localhost:6379
# Week 2: set to enable Kafka workers (e.g. redpanda:9092 in Docker, localhost:9092 on host)
KAFKA_BROKERS=
JWT_SECRET=replace-with-a-long-random-string
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
# openai, gemini, or mock. gemini uses the free Gemini API.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Public UI URL (Vercel). Worker links in API responses use this; the web app rewrites to window.location when you create from the browser.
APP_BASE_URL=http://localhost:4200
UPLOAD_DIR=uploads
PORT=3000

# MCP (Cursor / Claude Desktop): PP_API_BASE_URL=http://localhost:3000/api
# PayPal official MCP: npm run paypal-token (uses credentials above)
